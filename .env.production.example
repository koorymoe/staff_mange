# انسخ هذا الملف إلى .env بنفس مجلد docker-compose.yml وعدّل القيم قبل التشغيل
# cp .env.production.example .env

# كلمة سر قاعدة البيانات — اختر كلمة قوية وعشوائية
DB_PASSWORD=change-me-strong-password

# سر توقيع تسجيل الدخول (JWT) — لازم 16 حرف على الأقل، وكل ما كان أطول وعشوائي أحسن
JWT_SECRET=change-me-to-a-long-random-string

# رابط الموقع الفعلي (دومين الشركة) المسموح له يتواصل مع الباك إند
CORS_ORIGIN=https://your-domain.com

# (اختياري) تخزين الصور والفديوات على Object Storage — تعبّى لاحقاً
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=

# (اختياري) المساعد الذكي — مفتاح Gemini المجاني من aistudio.google.com/apikey
GEMINI_API_KEY=
# أقصى عدد أسئلة باليوم (حماية من تجاوز الحد المجاني)
GEMINI_DAILY_CAP=300
