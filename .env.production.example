# انسخ هذا الملف إلى .env بنفس مجلد docker-compose.yml وعدّل القيم قبل التشغيل
# cp .env.production.example .env

# كلمة سر قاعدة البيانات — اختر كلمة قوية وعشوائية
DB_PASSWORD=change-me-strong-password

# سر توقيع تسجيل الدخول (JWT) — لازم 16 حرف على الأقل، وكل ما كان أطول وعشوائي أحسن
JWT_SECRET=change-me-to-a-long-random-string

# رابط الموقع الفعلي (دومين الشركة) المسموح له يتواصل مع الباك إند
CORS_ORIGIN=https://your-domain.com

# (اختياري) تخزين الصور والفديوات على Object Storage — تعبّى لاحقاً
# تخزين الملفات (صور المنتجات، الوصولات، وثائق السيارات، عقود المشاريع).
#
# لو خلّيت الأربعة فاضية، النظام يخزّن على قرص السيرفر تحت UPLOADS_DIR —
# يشتغل بلا أي حساب خارجي. عبّيها إذا تريد التخزين يروح لـCloudflare R2.
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=

# مجلد التخزين المحلي. لازم يكون خارج مجلد الكود حتى ما ينمسح مع
# كل نشر جديد، ويندرج ضمن النسخ الاحتياطية.
UPLOADS_DIR=/var/lib/staff_mange/uploads

# (اختياري) المساعد الذكي — مفتاح Gemini المجاني من aistudio.google.com/apikey
GEMINI_API_KEY=
# أقصى عدد أسئلة باليوم (حماية من تجاوز الحد المجاني)
GEMINI_DAILY_CAP=300

# دومين الشركة (يستخدمه Caddy لإصدار شهادة HTTPS تلقائياً)
DOMAIN=your-domain.com

# بيانات دخول حساب المالك (OWNER) — لازم تنعطى هنا، ممنوع تنكتب بالكود.
# أول مرة يشتغل السيرفر وياهن، ينزرع/ينحدّث حساب المالك بهذي القيم.
OWNER_USERNAME=
OWNER_PASSWORD=
