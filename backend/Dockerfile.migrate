# حاوية تشتغل مرة وحدة بس: تطبق مخطط قاعدة البيانات الأساسي (Prisma) قبل
# ما يشتغل الباك إند الحقيقي (Go) — الباك إند الجديد يبني فوق هذا المخطط
# بس (migrations إضافية)، ما يصنعه من الصفر.
#
# نستخدم "db push" مو "migrate deploy" لأنه بعض الجداول (Vehicle، Mission،
# Project، Supplier، ...) انصنعت وقت التطوير مباشرة بقاعدة البيانات ("db
# push") وما انسجلت بملفات migration رسمية — فـ"migrate deploy" ناقصها.
# "db push" يقارن schema.prisma الحالي بقاعدة البيانات ويصنع أي شي ناقص،
# فيغطي كل الجداول دفعة وحدة. قاعدة البيانات فاضية بالبداية فما اكو خطر
# فقدان بيانات.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY prisma ./prisma
CMD ["npx", "prisma", "db", "push", "--skip-generate", "--accept-data-loss"]
