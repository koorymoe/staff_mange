// Prisma schema for staff_mange
// Core domain: Customers, Bookings (appointments), Employees, Services, Skill matching

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProjectPriority {
  NORMAL
  URGENT
}

enum BookingStatus {
  IN_PROGRESS // جاري التنفيذ
  PENDING // قبل الحجز - بانتظار التأكيد
  CONFIRMED // تم الحجز
  COMPLETED // تم إنجاز المهمة
  CANCELLED
}

enum EquipmentStatus {
  NOT_READY // لم يتم التجهيز
  READY // تم التجهيز
}

enum Shift {
  MORNING // صباحي
  EVENING // مسائي
}

enum TechnicianRole {
  TECH_1 // الفني الأول
  TECH_2 // الفني الثاني
  TECH_3 // الفني الثالث
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

// Determines which views/screens an employee can access in the app (no separate login)
enum EmployeeRole {
  ADMIN // يصل لكل الواجهات
  SALES // يسجل حجوزات جديدة (ما قبل الحجز)
  HR_COORDINATOR // الإداري: يثبت الحجز ويوجهه لكادر الشد أو إدارة المشاريع
  TECHNICIAN // الفني: يشوف مهامه، تقييمه، إنجازاته
  PROJECT_MANAGER
  MONITOR // مدقق/مراقب: يراقب كل الموظفين والحجوزات والحسابات والدوام
  FINANCE // المحاسب: يراجع المبالغ المستلمة من الحجوزات المنجزة
  GPS_ADMIN
  GPS_ENGINEER
  QUALITY_ENGINEER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ToolStatus {
  AVAILABLE
  CHECKED_OUT
  DAMAGED
}

enum ToolRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum ComplaintStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SimOperator {
  ZAIN
  ASIACELL
  KOREK
  OTHER
}

enum SimStatus {
  AVAILABLE
  IN_USE
}

enum GpsRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

enum GpsPurchaseType {
  DEVICE_SIM
  DEVICE_ONLY
}

enum GpsSubscriptionType {
  THREE_MONTHS
  SIX_MONTHS
  YEARLY
}

enum GpsSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum GpsMaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum QuotationStatus {
  NEW
  SENT
  ACCEPTED
  REJECTED
}

enum ProcurementRequestStatus {
  PENDING      // بانتظار التوفير
  IN_PROGRESS  // جاري التوفير
  FULFILLED    // تم التوفير
  REJECTED     // مرفوض
}

enum BookingType {
  REGULAR     // حجز عادي
  MAINTENANCE // حجز صيانة
}

enum BookingUrgency {
  ASAP          // أسرع وقت ممكن
  BY_PRIORITY   // حسب الأولوية
  SPECIFIC_DATE // تاريخ محدد
}

enum MaintenanceType {
  EXECUTION_ERROR // خطأ تنفيذ
  DEVICE_ISSUE    // مشكلة جهاز
}

enum WorkStatus {
  COMPLETED // مكتمل
  STOPPED   // متوقف
}

enum ProjectSpeed {
  URGENT        // مستعجل
  INTERNAL      // داخل الشركة
  REGULAR       // حجز اعتيادي
  DIRECTOR_REQ  // من طرف المدير
}

enum WorkType {
  FREE_MAINTENANCE // صيانة مجانية
  PAID             // تكلفة
}

// ---------------------------------------------------------------------------
// Services offered by the company (نوع العمل)
// ---------------------------------------------------------------------------

model Service {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())

  bookings Booking[]
  skills   Skill[]
}

// Specific skill/task within a service (e.g. تسليك كيبل كهرباء under الطاقة الشمسية)
model Skill {
  id        String   @id @default(cuid())
  name      String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  createdAt DateTime @default(now())

  employeeSkills EmployeeSkill[]

  @@unique([serviceId, name])
  @@index([serviceId])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id           String   @id @default(cuid())
  customerCode Int      @unique @default(autoincrement()) // رقم الزبون الثابت (CUST-00001)
  name         String // اسم الزبون / المؤسسة
  phone        String   @unique // رقم الهاتف
  location     String? // موقع الزبون / المؤسسة
  createdAt    DateTime @default(now())

  bookings   Booking[]
  complaints Complaint[]
}

// ---------------------------------------------------------------------------
// Employees & Skills (إدارة الكوادر)
// ---------------------------------------------------------------------------

model Employee {
  id          String         @id @default(cuid())
  name        String
  certificate String? // الشهادة
  position    String? // الترتيب / المنصب
  phone       String?
  status      EmployeeStatus @default(ACTIVE)
  role        EmployeeRole   @default(TECHNICIAN)
  onDuty      Boolean        @default(true) // هل الموظف بالدوام حالياً ومتاح للتكليف
  username    String?        @unique // اسم المستخدم لتسجيل الدخول
  password    String? // كلمة المرور (مشفرة)
  hasDrivingLicense   Boolean @default(false) // يملك رخصة قيادة
  hasSafetyCertificate Boolean @default(false) // يملك شهادة السلامة المهنية
  salary          Float?         // الراتب
  shift           Shift?         @default(MORNING) // دوام صباحي/مسائي
  monthlyLeaves   Int            @default(2) // إجازات شهرية
  jobTitle        String?        // العنوان الوظيفي
  leaderSkillLevel Int           @default(0) // مستوى المهارة كليدر (0-10)
  isLeader    Boolean        @default(false)
  createdAt   DateTime       @default(now())

  skills EmployeeSkill[]
  attendances  Attendance[]
  workReports  WorkReport[]

  // Bookings where this employee handled intake / transfer
  transferredBookings Booking[] @relation("TransferEmployee")
  // Bookings where this employee is the inspection supervisor
  inspectedBookings   Booking[] @relation("InspectionSupervisor")
  // Bookings where this employee is the project supervisor
  supervisedBookings  Booking[] @relation("ProjectSupervisor")
  // Bookings this employee confirmed (as coordinator/admin)
  confirmedBookings   Booking[] @relation("ConfirmedByEmployee")
  // Bookings where this employee is responsible for expenses
  expenseBookings     Booking[] @relation("ExpenseResponsible")

  assignments BookingAssignment[]
  expenses    Expense[]

  permissions         EmployeePermission[]
  kpiEvaluations      KpiEvaluation[] @relation("KpiEmployee")
  kpiEvaluationsGiven KpiEvaluation[] @relation("KpiEvaluator")
  personalTools       PersonalTool[]
  toolRequests        ToolRequest[]
  toolApprovals       ToolRequest[] @relation("ToolApprover")
  complaintsCreated   Complaint[] @relation("ComplaintCreator")
  complaintsAssigned  Complaint[] @relation("ComplaintAssignee")
  gpsDeviceRequests   GpsDeviceRequest[] @relation("GpsDeviceEmployee")
  gpsDeviceAdmin      GpsDeviceRequest[] @relation("GpsDeviceAdmin")
  gpsRenewalRequests  GpsRenewalRequest[] @relation("GpsRenewalEmployee")
  gpsRenewalAdmin     GpsRenewalRequest[] @relation("GpsRenewalAdmin")
  gpsMaintenanceRequests GpsMaintenanceRequest[] @relation("GpsMaintenanceEmployee")
  gpsMaintenanceAdmin    GpsMaintenanceRequest[] @relation("GpsMaintenanceAdmin")
  quotations          Quotation[] @relation("QuotationCreator")
  supplierRatings     SupplierRating[]
  procurementRequests    ProcurementRequest[] @relation("ProcurementRequester")
  procurementFulfilled   ProcurementRequest[] @relation("ProcurementFulfiller")
}

// مصاريف يدفعها الموظف من جيبه ويحتاج استرجاعها/استقطاعها
model Expense {
  id          String        @id @default(cuid())
  employee    Employee      @relation(fields: [employeeId], references: [id])
  employeeId  String
  amount      Float
  description String?
  status      ExpenseStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  @@index([employeeId])
}

// Many-to-many: which specific skills an employee can perform
model EmployeeSkill {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId    String
  canPerform Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([employeeId, skillId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// Bookings (قاعدة بيانات ما قبل الحجز + حجوزات المواعيد)
// ---------------------------------------------------------------------------

model Booking {
  id   String @id @default(cuid())
  code String @unique // الكود

  sequenceNumber Int? // تسلسل الحجز
  scheduledAt    DateTime? // الموعد المحدد لتنفيذ المهمة
  pendingScheduledAt DateTime? // موعد جديد مطلوب تعديله بانتظار موافقة المدقق

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String? // نوع العمل

  notes           String? // الملاحظات
  vehicleType     String? // نوع المركبة
  priority        ProjectPriority @default(NORMAL) // حالة المشروع: اعتيادي / عاجل
  status          BookingStatus   @default(PENDING) // حالة الحجز

  // Pre-booking stage (قاعدة بيانات ما قبل الحجز)
  transferEmployee   Employee? @relation("TransferEmployee", fields: [transferEmployeeId], references: [id])
  transferEmployeeId String?
  transferToProjects    Boolean   @default(false) // التحويل إلى إدارة المشاريع
  confirmedByName       String? // اسم مثبت الحجز (نص احتياطي)
  confirmedByEmployee   Employee? @relation("ConfirmedByEmployee", fields: [confirmedByEmployeeId], references: [id])
  confirmedByEmployeeId String? // الإداري الذي ثبّت الحجز (FK)
  adminNotes            String? // ملاحظات الإدارة

  // Scheduling stage (حجوزات المواعيد)
  equipmentStatus EquipmentStatus @default(NOT_READY) // حالة تجهيز المواد
  shift           Shift? // الشفت
  deviceCount     Int? // عدد الأجهزة

  inspectionSupervisor   Employee? @relation("InspectionSupervisor", fields: [inspectionSupervisorId], references: [id])
  inspectionSupervisorId String?

  projectSupervisor   Employee? @relation("ProjectSupervisor", fields: [projectSupervisorId], references: [id])
  projectSupervisorId String?

  projectCar    String? // سيارة المشروع
  crewNotes     String? // ملاحظات الكادر
  mapLocation   String? // الموقع على الخريطة

  expenseResponsible   Employee? @relation("ExpenseResponsible", fields: [expenseResponsibleId], references: [id])
  expenseResponsibleId String? // المسؤول عن المصاريف في هذا الحجز

  assignedVehicle String? // السيارة المخصصة لتنفيذ المهمة

  // Confirmation stage pricing/address (يضبطها الإداري عند التثبيت)
  quotedPrice Float? // التكلفة المقدرة للحجز
  address     String? // عنوان تنفيذ المهمة

  // Completion / finance handoff
  completedAt     DateTime? // وقت إنجاز المهمة من الفني
  completionNotes String? // ملاحظات الفني عند الإنجاز
  amountCollected Float? // المبلغ المستلم من الزبون
  advancePaid     Float? // دفعة مقدمة من الزبون
  amountVerified  Boolean @default(false) // تدقيق المحاسب على المبلغ

  bookingType          BookingType      @default(REGULAR)
  urgency              BookingUrgency?
  maintenanceType      MaintenanceType?
  remembersExecutionCrew Boolean        @default(false) // هل يتذكر الكادر المنفذ
  systemCount          Int?             // عدد المنظومات
  systemType           String?          // نوع المنظومات
  projectSpeed         ProjectSpeed?
  workType             WorkType?
  addressDescription   String?          // وصف مكان الموقع وأقرب نقطة دالة
  mapLatitude          Float?
  mapLongitude         Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments BookingAssignment[]
  cartItems   CartItem[]
  complaints  Complaint[]
  workReports WorkReport[]
  missions    Mission[]
  procurementRequests    ProcurementRequest[]

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
}

// Technicians assigned to a booking (الفني الأول / الثاني / الثالث)
model BookingAssignment {
  id         String         @id @default(cuid())
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String
  employee   Employee       @relation(fields: [employeeId], references: [id])
  employeeId String
  role       TechnicianRole
  createdAt  DateTime       @default(now())

  @@unique([bookingId, role])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Permissions
// ---------------------------------------------------------------------------

model Permission {
  id    String @id @default(cuid())
  name  String @unique // e.g. "staff_management", "gps_system", etc.
  label String // Arabic label
  employees EmployeePermission[]
}

model EmployeePermission {
  id           String     @id @default(cuid())
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime   @default(now())
  @@unique([employeeId, permissionId])
}

// ---------------------------------------------------------------------------
// KPI Evaluations
// ---------------------------------------------------------------------------

model KpiEvaluation {
  id              String   @id @default(cuid())
  employee        Employee @relation("KpiEmployee", fields: [employeeId], references: [id])
  employeeId      String
  evaluator       Employee @relation("KpiEvaluator", fields: [evaluatorId], references: [id])
  evaluatorId     String
  points          Int
  reason          String
  deductionAmount Float    // points * 10000
  createdAt       DateTime @default(now())
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Cart Items
// ---------------------------------------------------------------------------

model CartItem {
  id          String   @id @default(cuid())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Tools Management
// ---------------------------------------------------------------------------

model PersonalTool {
  id         String     @id @default(cuid())
  employee   Employee   @relation(fields: [employeeId], references: [id])
  employeeId String
  name       String
  barcode    String     @unique
  status     ToolStatus @default(AVAILABLE)
  checkedOut Boolean    @default(false)
  createdAt  DateTime   @default(now())
  @@index([employeeId])
}

model VehicleTool {
  id        String     @id @default(cuid())
  name      String
  barcode   String     @unique
  vehicleId String
  status    ToolStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  @@index([vehicleId])
}

model OnDemandTool {
  id                String     @id @default(cuid())
  name              String
  barcode           String     @unique
  totalQuantity     Int
  availableQuantity Int
  status            ToolStatus @default(AVAILABLE)
  createdAt         DateTime   @default(now())
  requests          ToolRequest[]
}

model ToolRequest {
  id           String            @id @default(cuid())
  employee     Employee          @relation(fields: [employeeId], references: [id])
  employeeId   String
  tool         OnDemandTool      @relation(fields: [toolId], references: [id])
  toolId       String
  status       ToolRequestStatus @default(PENDING)
  approvedBy   Employee?         @relation("ToolApprover", fields: [approvedById], references: [id])
  approvedById String?
  requestedAt  DateTime          @default(now())
  returnedAt   DateTime?
  @@index([employeeId])
  @@index([toolId])
}

// ---------------------------------------------------------------------------
// Complaints
// ---------------------------------------------------------------------------

model Complaint {
  id                    String          @id @default(cuid())
  customer              Customer        @relation(fields: [customerId], references: [id])
  customerId            String
  booking               Booking?        @relation(fields: [bookingId], references: [id])
  bookingId             String?
  description           String
  status                ComplaintStatus  @default(NEW)
  createdByEmployee     Employee        @relation("ComplaintCreator", fields: [createdByEmployeeId], references: [id])
  createdByEmployeeId   String
  assignedToEmployee    Employee?       @relation("ComplaintAssignee", fields: [assignedToEmployeeId], references: [id])
  assignedToEmployeeId  String?
  resolution            String?
  createdAt             DateTime        @default(now())
  resolvedAt            DateTime?
  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// GPS System
// ---------------------------------------------------------------------------

model GpsCustomer {
  id                    String   @id @default(cuid())
  fullName              String
  fatherName            String?
  grandfatherName       String?
  phone                 String
  address               String?
  governorate           String?
  idCardFrontUrl        String?
  idCardBackUrl         String?
  residenceCardFrontUrl String?
  residenceCardBackUrl  String?
  createdAt             DateTime @default(now())
  simCards              SimCard[]
  deviceRequests        GpsDeviceRequest[]
  renewalRequests       GpsRenewalRequest[]
  maintenanceRequests   GpsMaintenanceRequest[]
}

model SimCard {
  id         String    @id @default(cuid())
  simNumber  String    @unique
  iccid      String?
  operator   SimOperator
  status     SimStatus @default(AVAILABLE)
  customer   GpsCustomer? @relation(fields: [customerId], references: [id])
  customerId String?
  notes      String?
  createdAt  DateTime  @default(now())
  deviceRequests GpsDeviceRequest[]
  @@index([status])
}

model GpsDeviceRequest {
  id                 String              @id @default(cuid())
  customer           GpsCustomer         @relation(fields: [customerId], references: [id])
  customerId         String
  employee           Employee            @relation("GpsDeviceEmployee", fields: [employeeId], references: [id])
  employeeId         String
  admin              Employee?           @relation("GpsDeviceAdmin", fields: [adminId], references: [id])
  adminId            String?
  purchaseType       GpsPurchaseType
  subscriptionType   GpsSubscriptionType
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  subscriptionStatus GpsSubscriptionStatus @default(ACTIVE)
  status             GpsRequestStatus    @default(PENDING)
  simCard            SimCard?            @relation(fields: [simCardId], references: [id])
  simCardId          String?
  notes              String?
  isChecked          Boolean             @default(false)
  isActivated        Boolean             @default(false)
  isDelivered        Boolean             @default(false)
  invoicePhotoUrl    String?
  activationDate     DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime            @default(now())
  renewals           GpsRenewalRequest[]
  @@index([customerId])
  @@index([status])
}

model GpsRenewalRequest {
  id               String              @id @default(cuid())
  customer         GpsCustomer         @relation(fields: [customerId], references: [id])
  customerId       String
  deviceRequest    GpsDeviceRequest    @relation(fields: [deviceRequestId], references: [id])
  deviceRequestId  String
  employee         Employee            @relation("GpsRenewalEmployee", fields: [employeeId], references: [id])
  employeeId       String
  admin            Employee?           @relation("GpsRenewalAdmin", fields: [adminId], references: [id])
  adminId          String?
  subscriptionType GpsSubscriptionType
  newEndDate       DateTime?
  status           GpsRequestStatus    @default(PENDING)
  createdAt        DateTime            @default(now())
  @@index([customerId])
}

model GpsMaintenanceRequest {
  id                 String               @id @default(cuid())
  customer           GpsCustomer          @relation(fields: [customerId], references: [id])
  customerId         String
  employee           Employee             @relation("GpsMaintenanceEmployee", fields: [employeeId], references: [id])
  employeeId         String
  admin              Employee?            @relation("GpsMaintenanceAdmin", fields: [adminId], references: [id])
  adminId            String?
  problemDescription String
  status             GpsMaintenanceStatus @default(PENDING)
  adminNotes         String?
  createdAt          DateTime             @default(now())
  resolvedAt         DateTime?
  @@index([customerId])
}

model GpsSubscriptionPrice {
  id               String              @id @default(cuid())
  subscriptionType GpsSubscriptionType @unique
  price            Float
  createdAt        DateTime            @default(now())
}

// ---------------------------------------------------------------------------
// Products & Quotations
// ---------------------------------------------------------------------------

model Product {
  id           String   @id @default(cuid())
  name         String   @unique
  unit         String?
  defaultPrice Float?
  imageBase64  String?  @db.Text
  createdAt    DateTime @default(now())
}

model Quotation {
  id               String          @id @default(cuid())
  quotationNumber  String          @unique
  customerName     String
  customerPhone    String?
  customerAddress  String?
  projectName      String?
  grandTotal       Float           @default(0)
  discountPercent  Float           @default(0)
  discountValue    Float           @default(0)
  netTotal         Float           @default(0)
  notes            String?
  duration         String?
  status           QuotationStatus @default(NEW)
  createdByEmployee Employee       @relation("QuotationCreator", fields: [createdByEmployeeId], references: [id])
  createdByEmployeeId String
  createdAt        DateTime        @default(now())
  items            QuotationItem[]
  @@index([status])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String
  productName String
  unit        String?
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  @@index([quotationId])
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

model Attendance {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  checkIn    DateTime @default(now())
  checkOut   DateTime?
  date       DateTime @default(now()) // just the date portion for uniqueness
  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Work Reports
// ---------------------------------------------------------------------------

model WorkReport {
  id              String     @id @default(cuid())
  booking         Booking    @relation(fields: [bookingId], references: [id])
  bookingId       String
  employee        Employee   @relation(fields: [employeeId], references: [id])
  employeeId      String
  workStatus      WorkStatus
  events          String?    // الأحداث والمشاكل
  extraRequests   String?    // طلبات الزبون الإضافية
  cleanedSite     Boolean    @default(false) // هل نظف المكان
  gaveInfo        Boolean    @default(false) // هل أعطى المعلومات للزبون
  tookPhotos      Boolean    @default(false) // هل صور العمل
  stopReason      String?    // سبب التوقف (في حال WorkStatus = STOPPED)
  notes           String?
  createdAt       DateTime   @default(now())
  @@index([bookingId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Vehicles
// ---------------------------------------------------------------------------

model Vehicle {
  id          String   @id @default(cuid())
  name        String   // مثال: تويوتا هايلوكس
  plateNumber String   @unique
  color       String?
  type        String?  // نوع السيارة
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Suppliers (الموردون)
// ---------------------------------------------------------------------------

model SupplierSpecialty {
  id        String     @id @default(cuid())
  name      String     @unique
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  suppliers SupplierSpecialtyLink[]
}

model Supplier {
  id          String    @id @default(cuid())
  companyName String
  ownerName   String
  phone       String
  lat         Float?
  lng         Float?
  isMaterialSupplier  Boolean @default(false)
  isContractor        Boolean @default(false)
  traderTypes String[] // ["وكيل", "موزع", "تاجر"]
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  specialties SupplierSpecialtyLink[]
  ratings     SupplierRating[]
}

model SupplierSpecialtyLink {
  supplier    Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId  String
  specialty   SupplierSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  specialtyId String
  @@id([supplierId, specialtyId])
}

model SupplierRating {
  id         String   @id @default(cuid())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  value      Int      // 1-5
  note       String?
  ratedBy    Employee @relation(fields: [ratedById], references: [id])
  ratedById  String
  ratedByName String
  createdAt  DateTime @default(now())
  @@index([supplierId])
}

// ---------------------------------------------------------------------------
// Mission Tracking (نظام تتبع المهام الميدانية)
// ---------------------------------------------------------------------------

enum MissionStage {
  ASSIGNED         // تم الإسناد — بانتظار استلام الليدر
  MATERIALS_PREP   // الليدر يجهز المواد
  MATERIALS_READY  // المواد جاهزة — عداد الموظف بدأ
  EN_ROUTE         // بالطريق — الفريق انطلق
  ARRIVED          // وصلو للموقع
  WORK_STARTED     // بدأ العمل
  COMPLETED        // تم الإنجاز
  STOPPED          // متوقف
}

model Mission {
  id              String       @id @default(cuid())
  code            String       @unique // MSN-0001
  booking         Booking      @relation(fields: [bookingId], references: [id])
  bookingId       String
  stage           MissionStage @default(ASSIGNED)

  // الفريق
  leaderId        String       // الليدر
  memberIds       String[]     // باقي الأعضاء

  // موقع الزبون
  customerLat     Float?
  customerLng     Float?
  customerAddress String?

  // أوقات كل مرحلة
  assignedAt        DateTime   @default(now())
  materialsReadyAt  DateTime?  // الليدر أكد جهوزية المواد
  departedAt        DateTime?  // الفريق انطلق
  arrivedAt         DateTime?  // وصلو
  workStartedAt     DateTime?  // بدأ العمل
  completedAt       DateTime?  // تم الإنجاز
  stoppedAt         DateTime?  // توقف

  // معلومات التنقل
  departureLat      Float?     // موقع الانطلاق
  departureLng      Float?
  arrivalLat        Float?     // موقع الوصول (GPS يؤكد)
  arrivalLng        Float?
  estimatedMinutes  Int?       // الوقت المتوقع للوصول بالدقائق
  actualMinutes     Int?       // الوقت الفعلي للوصول
  distanceKm        Float?     // المسافة بالكيلومتر

  // نتيجة
  stopReason        String?    // سبب التوقف
  notes             String?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  events            MissionEvent[]

  @@index([bookingId])
  @@index([stage])
  @@index([leaderId])
}

model MissionEvent {
  id          String   @id @default(cuid())
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId   String
  employeeId  String   // من سوا الحدث
  action      String   // MATERIALS_READY, DEPARTED, ARRIVED, WORK_STARTED, COMPLETED, STOPPED
  lat         Float?
  lng         Float?
  note        String?
  createdAt   DateTime @default(now())

  @@index([missionId])
}

// ---------------------------------------------------------------------------
// Project Management (إدارة وأرشفة المشاريع)
// Pipeline: اتصال → كشف → سعر → تنفيذ → مكتمل / مرفوض
// ---------------------------------------------------------------------------

model Project {
  id           String   @id @default(cuid())
  code         String   @unique // PRJ-xxxx
  name         String   // المؤسسة
  rep          String?  // الممثل
  phone        String?  // الهاتف
  location     String?  // الموقع
  workType     String?  // نوع العمل (طاقة شمسية / كاميرات / ...)
  refPerson    String?  // الطرف الوسيط
  stage        String   @default("1. اتصال بالزبون") // المرحلة
  price        String?  // المبلغ التخميني
  staff        String?  // الموظفين / فريق العمل
  time         String?  // الوقت / الموعد
  task         String?  // المهمة / الملاحظات / سبب الرفض
  priority     String   @default("عادي") // عادي / عاجل جداً
  deliveryDate String?  // تاريخ التسليم
  survey       Json?    // مصفوفة 17 إجابة لاستمارة الكشف
  sentToGroup  Boolean  @default(false) // أُرسلت البيانات للجروب؟
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([stage])
}

// ---------------------------------------------------------------------------
// Procurement / Material Requests (نظام المشتريات)
// ---------------------------------------------------------------------------

model ProcurementRequest {
  id              String   @id @default(cuid())
  code            String   @unique // PR-0001
  requestedBy     Employee @relation("ProcurementRequester", fields: [requestedById], references: [id])
  requestedById   String
  booking         Booking? @relation(fields: [bookingId], references: [id])
  bookingId       String?
  notes           String?
  status          ProcurementRequestStatus @default(PENDING)
  fulfilledBy     Employee? @relation("ProcurementFulfiller", fields: [fulfilledById], references: [id])
  fulfilledById   String?
  totalCost       Float?
  fulfillmentNotes String?
  createdAt       DateTime @default(now())
  fulfilledAt     DateTime?
  items           ProcurementItem[]
  @@index([requestedById])
  @@index([status])
}

model ProcurementItem {
  id          String   @id @default(cuid())
  request     ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String
  productName String
  quantity    Int
  unitPrice   Float?
  totalPrice  Float?
  fulfilled   Boolean @default(false)
  @@index([requestId])
}
