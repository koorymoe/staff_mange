# لتشغيل الباك إندين بالتوازي محلياً على نفس الجهاز، خلي بورت Go مختلف عن
# بورت TypeScript (4000) — هنا 4001. لازم يطابق البورت المكتوب بـ
# frontend/.env.local (VITE_API_URL) إذا رحت تشغّل الفرونت إند ضد Go.
PORT=4001
DATABASE_URL=postgresql://postgres:m0204z@localhost:5433/postgres
JWT_SECRET=change-me-to-a-long-random-string
# نفس أصل الفرونت إند المحلي المسموح له بالوصول (CORS) — طابق هذا مع رابط
# الفرونت إند الفعلي، وافصل بينهم بفاصلة إذا أكثر من أصل واحد.
CORS_ORIGIN=http://localhost:5173
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
