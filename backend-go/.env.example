# هذا الباك إند الآن يشتغل بنفس البورت ونفس مسارات /api اللي كان يستخدمها
# الباك إند القديم (TypeScript) بالضبط — يعني الفرونت إند ما يحتاج أي تعديل،
# فقط شغّل هذا السيرفر بدل `npm run dev` بمجلد backend/.
# (إذا احتجت تشغّل الاثنين بالتوازي مؤقتاً للمقارنة، غيّر PORT هنا لأي رقم
# آخر مثل 4001 وعدّل VITE_API_URL بالفرونت إند ليطابقه.)
PORT=4000
DATABASE_URL=postgresql://postgres:m0204z@localhost:5433/postgres
JWT_SECRET=change-me-to-a-long-random-string
# نفس أصل الفرونت إند المحلي المسموح له بالوصول (CORS) — طابق هذا مع رابط
# الفرونت إند الفعلي، وافصل بينهم بفاصلة إذا أكثر من أصل واحد.
CORS_ORIGIN=http://localhost:5173
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
# بيانات دخول حساب المالك (OWNER) — لازم تنعطى هنا فقط، ممنوع تنكتب بالكود.
# أول مرة يشتغل السيرفر وياهن، ينزرع/ينحدّث حساب المالك بهذي القيم. لو خليتهن
# فاضيات، حساب المالك الموجود يبقى كما هو بدون أي تغيير.
OWNER_USERNAME=
OWNER_PASSWORD=
