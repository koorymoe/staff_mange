# انسخ هذا الملف إلى .env.local (cp .env.local.example .env.local)
#
# شغّل الفرونت إند ضد الباك إند القديم (TypeScript/Express، بورت 4000):
VITE_API_URL=http://localhost:4000/api
#
# أو شغّله ضد الباك إند الجديد (Go، بورت 4001) — نفس شكل الاستجابات بالضبط،
# ما يحتاج أي تعديل بكود الفرونت إند:
# VITE_API_URL=http://localhost:4001/api/v1
